<main class="standalone-auth-wrap">
    <section class="card standalone-auth-panel" aria-labelledby="logout-title">
        <h1 id="logout-title">Sign out of Upgrade Center?</h1>
        <form asp-controller="StandaloneAuthentication" asp-action="SignOutLocal" method="post">
            <button type="submit" class="btn btn-primary">Sign out</button>
            <a asp-controller="UpgradeCenter" asp-action="Index" class="btn btn-secondary">Cancel</a>
        </form>
    </section>
</main>
