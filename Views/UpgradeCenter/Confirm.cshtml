@using BoldBI.UpgradeCenter.Models
@using BoldBI.UpgradeCenter.Models.ViewModels
@model ConfirmUpgradeViewModel

@{
    ViewData["Title"] = "Confirm Upgrade";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Top bar -->
<partial name="_Topbar" model="@Model.CurrentUser" />

<!-- The confirm dialog is rendered as an overlay on a blurred background page -->
<div class="modal-scrim">
    <div class="modal-card">
        <h2>Confirm upgrade</h2>
        <p class="sub">
            Review the details below before starting.
            You'll be able to monitor every step once it begins.
        </p>

        <!-- Version swap row -->
        <div class="swap-row">
            <div class="swap-item">
                <div class="t">From</div>
                <div class="v">v@(Model.FromVersion)</div>
            </div>
            <div class="swap-arrow">→</div>
            <div class="swap-item">
                <div class="t">To</div>
                <div class="v">
                    @if (Model.ReleaseType == ReleaseType.CustomPatch)
                    {
                        <span>@(Model.ToVersion) <span class="badge badge-grey" style="font-size:10px;">patch</span></span>
                    }
                    else
                    {
                        @($"v{Model.ToVersion}")
                    }
                </div>
            </div>
        </div>

        <!-- Schema-change notice -->
        @if (Model.HasSchemaChanges)
        {
            <div class="modal-note">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" style="flex-shrink:0;margin-top:1px">
                    <circle cx="8" cy="8" r="7" stroke="#2452B8" stroke-width="1.5"/>
                    <path d="M8 5v4M8 11v.5" stroke="#2452B8" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
                This release includes schema changes. Affected tables will be backed up automatically
                before anything is applied — no manual steps required.
            </div>
        }

        <!-- Custom patch image reference display -->
        @if (Model.ReleaseType == ReleaseType.CustomPatch && !string.IsNullOrWhiteSpace(Model.CustomImageReference))
        {
            <div class="modal-note" style="background:var(--amber-100);">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" style="flex-shrink:0;margin-top:1px">
                    <path d="M8 2L14 13H2L8 2Z" stroke="#B7791F" stroke-width="1.5" stroke-linejoin="round"/>
                    <path d="M8 7v3M8 11.5v.5" stroke="#B7791F" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
                Custom patch: <code style="font-family:var(--mono);font-size:11.5px;word-break:break-all">@Model.CustomImageReference</code>
            </div>
        }

        <!-- Actions -->
        <div class="modal-actions">
            <a class="btn btn-secondary"
               href="@Url.Action("Index", "UpgradeCenter")">
                Cancel
            </a>

            <form method="post"
                  asp-controller="UpgradeCenter"
                  asp-action="StartUpgrade"
                  style="display:inline">
                @Html.AntiForgeryToken()
                <input type="hidden" name="version"  value="@Model.ToVersion" />
                <input type="hidden" name="imageRef" value="@Model.CustomImageReference" />
                <button type="submit" class="btn btn-primary">Start upgrade →</button>
            </form>
        </div>
    </div>
</div>
