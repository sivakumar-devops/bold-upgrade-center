@using BoldBI.UpgradeCenter.Models
@using BoldBI.UpgradeCenter.Models.ViewModels
@model MonitoringViewModel

@{
    var job = Model.Job;

    string RailClass(int index)
    {
        if (index >= job.Stages.Count) return "";
        return job.Stages[index].Status switch
        {
            StageStatus.Passed  => "done",
            StageStatus.Running => "running",
            StageStatus.Failed  => "failed",
            _                   => ""
        };
    }

    string StageIconClass(StageStatus s) => s switch
    {
        StageStatus.Passed  => "pass",
        StageStatus.Running => "run",
        StageStatus.Failed  => "fail",
        _                   => "skip"
    };

    string StageIconLabel(StageStatus s) => s switch
    {
        StageStatus.Passed  => "OK",
        StageStatus.Running => "...",
        StageStatus.Failed  => "!",
        _                   => "-"
    };

    string BadgeClass(StageStatus s) => s switch
    {
        StageStatus.Passed  => "badge-teal",
        StageStatus.Running => "badge-blue",
        StageStatus.Failed  => "badge-red",
        _                   => "badge-grey"
    };

    string BadgeLabel(StageStatus s) => s switch
    {
        StageStatus.Passed  => "Passed",
        StageStatus.Running => "Running",
        StageStatus.Failed  => "Failed",
        StageStatus.Skipped => "Skipped",
        _                   => "Pending"
    };

    string JobBadgeClass(UpgradeJobStatus s) => s switch
    {
        UpgradeJobStatus.Completed   => "badge-teal",
        UpgradeJobStatus.Failed      => "badge-red",
        UpgradeJobStatus.Running     => "badge-amber",
        UpgradeJobStatus.RollingBack => "badge-blue",
        UpgradeJobStatus.RolledBack  => "badge-grey",
        _                            => "badge-grey"
    };

    string JobBadgeLabel(UpgradeJobStatus s) => s switch
    {
        UpgradeJobStatus.Completed   => "Completed",
        UpgradeJobStatus.Failed      => "Action required",
        UpgradeJobStatus.Running     => "Running",
        UpgradeJobStatus.RollingBack => "Rolling back",
        UpgradeJobStatus.RolledBack  => "Rolled back",
        _                            => "Pending"
    };

    string FormatDuration(TimeSpan? d) =>
        d.HasValue ? $"{(int)d.Value.TotalMinutes}m {d.Value.Seconds}s" : "-";

    string FormatStageStatus(JobStage stage) =>
        stage.Status == StageStatus.Passed  ? $"Passed - {FormatDuration(stage.Duration)}" :
        stage.Status == StageStatus.Running ? "Running..." :
        stage.Status == StageStatus.Failed  ? $"{stage.Checks.Count(c => !c.Passed)} checks failed" :
        stage.Status == StageStatus.Skipped ? "Skipped" :
        "Pending";

    string FailureTitle(JobStage? stage)
    {
        var name = stage?.Name ?? string.Empty;
        return name switch
        {
            "Pre-Upgrade Validation" => "Pre-upgrade validation found issues.",
            "Schema Backup" => "Schema backup failed.",
            "Upgrade" => "Upgrade failed.",
            "Post-Upgrade Validation" => "Post-upgrade validation found issues.",
            _ => "Upgrade workflow found issues."
        };
    }

    string FailureMessage(JobStage? stage)
    {
        var name = stage?.Name ?? string.Empty;
        return name switch
        {
            "Pre-Upgrade Validation" => "No database backup or deployment image change should have been applied before this failure.",
            "Schema Backup" => "The upgrade was stopped before deployment images were changed. Review the schema backup details and retry after fixing the issue.",
            "Upgrade" => "Rollback is available only if the previous images and database backup were recorded successfully.",
            "Post-Upgrade Validation" => $"Rolling back restores v{job.FromVersion} and the backed-up tables when a valid rollback point is available.",
            _ => "Review the failed stage details before retrying or starting rollback."
        };
    }

    var isLatestRollbackable = ViewData["IsLatestRollbackable"] is bool b && b;
    var failedStage = job.Stages.FirstOrDefault(stage => stage.Status == StageStatus.Failed);
}

<div class="job-header">
    <div>
        <div class="eyebrow">@(job.IsRollback ? $"Rollback job - reverting job {job.RevertsJobId}" : "Upgrade job")</div>
        <h1 class="page-title">v@(job.FromVersion) -> v@(job.ToVersion)</h1>
        <div class="job-id">
            Job ID: @job.JobId - started @job.StartedAt.ToString("HH:mm:ss, dd MMM yyyy")
        </div>
    </div>
    <span class="badge @JobBadgeClass(job.Status)">@JobBadgeLabel(job.Status)</span>
</div>

<div class="rail">
    @for (var index = 0; index < Model.PhaseLabels.Count; index++)
    {
        var railClass = RailClass(index);
        var dotText = railClass == "done" ? "OK" :
            railClass == "running" ? "..." :
            railClass == "failed" ? "!" :
            (index + 1).ToString();

        <div class="rail-step @railClass">
            <div class="line"></div>
            <div class="dot">@dotText</div>
            <div class="stitle">@Model.PhaseLabels[index]</div>
            <div class="sstatus">@(job.Stages.Count > index ? FormatStageStatus(job.Stages[index]) : "Pending")</div>
        </div>
    }
</div>

@if (job.Status == UpgradeJobStatus.Completed)
{
    <div class="success-banner">
        <div class="txt">
            <b>Upgrade completed successfully.</b>
            <span>Bold BI is now running v@(job.ToVersion). No further action is required.</span>
        </div>
        @if (job.CanRollBack && isLatestRollbackable)
        {
            <a class="btn btn-secondary"
               href="@Url.Action("ConfirmRollback", "UpgradeCenter", new { jobId = job.JobId })">
                Roll back this upgrade
            </a>
        }
        else if (job.CanRollBack && !isLatestRollbackable)
        {
            <span class="badge badge-grey" title="Only the most recent upgrade can be rolled back.">
                Rollback unavailable - newer upgrade exists
            </span>
        }
    </div>
}
else if (job.Status == UpgradeJobStatus.Failed)
{
    <div class="fail-banner">
        <div class="txt">
            <b>@FailureTitle(failedStage)</b>
            <span>@FailureMessage(failedStage)</span>
        </div>
        @if (isLatestRollbackable)
        {
            <a class="btn btn-danger"
               href="@Url.Action("ConfirmRollback", "UpgradeCenter", new { jobId = job.JobId })">
                Roll back to v@(job.FromVersion)
            </a>
        }
        else
        {
            <span class="badge badge-grey" title="Only the most recent upgrade can be rolled back.">
                Rollback unavailable - newer upgrade exists
            </span>
        }
    </div>
}
else if (job.Status == UpgradeJobStatus.RollingBack)
{
    <div class="banner">
        <div class="txt">
            <b>Rollback in progress.</b>
            <span>Bold BI will be back on v@(job.ToVersion) with the pre-upgrade data restored once this finishes. This page updates automatically.</span>
        </div>
    </div>
}
else if (job.Status == UpgradeJobStatus.Running)
{
    <div class="banner running">
        <div class="txt">
            <b>Upgrade in progress.</b>
            <span>Started by @job.InitiatedBy - @(job.CurrentStage != null ? $"currently running: {job.CurrentStage.Name}" : "preparing...")</span>
        </div>
    </div>
}

@foreach (var stage in job.Stages)
{
    var iconCls = StageIconClass(stage.Status);
    var hasProgress = stage.Checks.Count > 0;
    var hasLogs = stage.LogLines.Count > 0;
    var hasDetails = hasProgress || hasLogs;
    var hasHtmlReport = !string.IsNullOrWhiteSpace(stage.HtmlReportUrl);
    var detailsKey = $"stage:{job.JobId}:{stage.Name}";

    <div class="card stage-card">
        <div class="stage-head">
            <div class="stage-head-left">
                <div class="stage-icon @iconCls">@StageIconLabel(stage.Status)</div>
                <div>
                    <div class="stage-name">@stage.Name</div>
                    <div class="stage-summary">
                        @if (!string.IsNullOrWhiteSpace(stage.Meta))
                        {
                            <span>@stage.Meta</span>
                        }
                        else if (stage.Checks.Count > 0)
                        {
                            var passed = stage.Checks.Count(c => c.Passed);
                            <span>@passed of @stage.Checks.Count checks passed</span>
                        }
                        else
                        {
                            <span>@BadgeLabel(stage.Status)</span>
                        }

                        @if (stage.Duration.HasValue)
                        {
                            <span class="stage-duration">@FormatDuration(stage.Duration)</span>
                        }
                    </div>
                </div>
            </div>
            <span class="badge @BadgeClass(stage.Status)">@BadgeLabel(stage.Status)</span>
        </div>

        @if (hasHtmlReport || hasDetails)
        {
            <div class="stage-body">
                @if (hasDetails)
                {
                    <details class="stage-log-details" data-details-key="@detailsKey">
                        <summary class="stage-action-row">
                            <span class="stage-action-left">
                                @if (hasHtmlReport)
                                {
                                    <a class="stage-action-link stage-report-link"
                                       href="@stage.HtmlReportUrl"
                                       target="_blank"
                                       rel="noopener"
                                       onclick="event.stopPropagation();">
                                        View HTML Report
                                    </a>
                                }
                            </span>
                            <span class="stage-action-link stage-action-right">
                                <span class="summary-open">Hide Details</span>
                                <span class="summary-closed">View Details</span>
                            </span>
                        </summary>

                        <div class="stage-details-content">
                            @if (hasProgress)
                            {
                                <div class="stage-log-heading">Progress Details</div>
                                <ul class="stage-progress-list">
                                    @foreach (var check in stage.Checks)
                                    {
                                        <li class="@(check.Passed ? "good" : "bad")">@check.Description</li>
                                    }
                                </ul>
                            }
                            else if (hasLogs)
                            {
                                <div class="stage-log-heading">Detailed Logs</div>
                                <div class="log-box">
                                    @foreach (var line in stage.LogLines)
                                    {
                                        @line<br />
                                    }
                                </div>
                            }
                        </div>
                    </details>
                }
                else if (hasHtmlReport)
                {
                    <div class="stage-action-row">
                        <span class="stage-action-left">
                            <a class="stage-action-link stage-report-link"
                               href="@stage.HtmlReportUrl"
                               target="_blank"
                               rel="noopener">
                                View HTML Report
                            </a>
                        </span>
                    </div>
                }
            </div>
        }
    </div>
}

@if (job.CompleteLogLines.Count > 0)
{
    <div class="card complete-log-card">
        <div class="complete-log-head">
            <div>
                <div class="stage-name">Complete operation logs</div>
                <div class="stage-summary">
                    <span>
                        Includes database backup/restore, Playwright validation, Kubernetes upgrade/rollback,
                        warnings, errors, and final operation status.
                    </span>
                </div>
            </div>
        </div>
        <div class="stage-body complete-log-body">
            <details class="stage-log-details complete-log-details" data-details-key="complete:@job.JobId">
                <summary class="stage-action-row">
                    <span class="stage-action-left"></span>
                    <span class="stage-action-link stage-action-right">
                        <span class="summary-open">Hide Complete Logs</span>
                        <span class="summary-closed">View Complete Logs</span>
                    </span>
                </summary>
                <div class="stage-details-content">
                    <div class="stage-log-heading">Detailed Logs</div>
                    <div class="log-box complete-log-box"
                         id="complete-log-box"
                         data-last-sequence="@job.CompleteLogSequence">
                        @foreach (var line in job.CompleteLogLines)
                        {
                            if (string.IsNullOrWhiteSpace(line))
                            {
                                <br />
                            }
                            else
                            {
                                @line<br />
                            }
                        }
                    </div>
                </div>
            </details>
        </div>
    </div>
}
