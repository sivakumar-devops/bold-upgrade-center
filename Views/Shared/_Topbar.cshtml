@using BoldBI.UpgradeCenter.Models
@model UpgradeCenterUser

<div class="product-topbar">
    <div class="brand">
        <img class="brand-logo" src="~/upgrade-center/images/main_logo.svg" asp-append-version="true" alt="Bold BI" />
        <div class="name">Bold BI</div>
        <div class="crumb">Upgrade Center</div>
    </div>
    <div class="user-chip">
        <div class="avatar">@Model.Initials</div>
        @Model.DisplayName · @Model.Role
    </div>
</div>
