{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "UpgradeCenter": {
    "ProductName": "Bold BI",
    "ReleaseVersionsApiUrl": "https://boldbi-release-api.boldbidemo.com/version/json",
    "Services": {
      "IdpApi": "",
      "Ums": ""
    },
    "Authentication": {
      "LoginPath": "/accounts/login",
      "SessionValidationPath": "/upgrade-center/auth/session",
      "AdminValidationPath": "/upgrade-center/authorization/admin",
      "IdpPublicUrlOverride": ""
    },
    "Playwright": {
      "UseKubernetesJob": false,
      "RunnerImage": "sivakumar2809/upgrade-center-qa:v0.1",
      "JobTimeoutSeconds": 7200,
      "JobPollSeconds": 5,
      "BackoffLimit": 0,
      "CompletedJobTtlSeconds": 3600,
      "SharedStateVolumeEnabled": true,
      "SharedStateStorageClassName": "",
      "SharedStateStorageSize": "1Gi",
      "SharedStateAccessMode": "ReadWriteOnce",
      "SharedStateMountPath": "/app/playwright-shared-state",
      "SharedStateFsGroup": 1001,
      "PassRateThreshold": "100",
      "ReportPath": "/app/pre-upgrade-test-results/reports.html",
      "PreJunitReportPath": "/app/pre-upgrade-test-results/junit-report.xml",
      "PostJunitReportPath": "/app/post-upgrade-test-results/junit-report.xml",
      "PreHtmlReportPath": "/app/pre-upgrade-test-results/reports.html",
      "PostHtmlReportPath": "/app/post-upgrade-test-results/reports.html",
      "PreHtmlReportDirectory": "/app/pre-upgrade-test-results",
      "PostHtmlReportDirectory": "/app/post-upgrade-test-results",
      "ReportStoragePath": "App_Data/PlaywrightReports",
      "ReportUploadBaseUrl": "http://boldbi-upgrade-center/upgrade-center/api/playwright-reports",
      "ResultUploadBaseUrl": "http://boldbi-upgrade-center/upgrade-center/api/playwright-results",
      "ReportRetentionJobCount": 7
    }
  },
  "AllowedHosts": "*"
}
